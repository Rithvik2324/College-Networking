generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                   Int                    @id @default(autoincrement())
  name                 String
  email                String                 @unique
  passwordHash         String
  role                 String                 @default("student")
  college              String?
  department           String?
  yearOfStudy          Int?
  avatarUrl            String?
  intent               String                 @default("Project-Building")
  primarySkill         String                 @default("Frontend")
  availability         Int                    @default(8)
  bio                  String                 @default("")
  onboardingComplete   Boolean                @default(false)
  onboardingStep       Int                    @default(1)
  notificationsEnabled Boolean                @default(true)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  skills               UserSkill[]
  interests            UserInterest[]
  ownedCommunities     Community[]            @relation("CommunityOwner")
  communityMemberships CommunityMember[]
  sentInvitations      CommunityInvitation[]  @relation("InvitationSender")
  receivedInvitations  CommunityInvitation[]  @relation("InvitationReceiver")
  sentRequests         CollaborationRequest[] @relation("RequestSender")
  receivedRequests     CollaborationRequest[] @relation("RequestReceiver")
  ownedProjects        Project[]              @relation("ProjectOwner")
  projectMemberships   ProjectMember[]
  projectJoinRequests  ProjectJoinRequest[]   @relation("ProjectApplicant")
  reviewedJoinRequests ProjectJoinRequest[]   @relation("ProjectReviewer")
  createdTasks         Task[]                 @relation("TaskCreator")
  assignedTasks        Task[]                 @relation("TaskAssignee")
  taskActivities       TaskActivity[]
  conversationMembers  ConversationMember[]
  sentMessages         Message[]              @relation("MessageSender")
  notifications        Notification[]
}

model Skill {
  id       Int            @id @default(autoincrement())
  name     String         @unique
  users    UserSkill[]
  projects ProjectSkill[]
}

model UserSkill {
  userId  Int
  skillId Int
  level   String @default("intermediate")
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
  @@index([skillId])
}

model Interest {
  id    Int            @id @default(autoincrement())
  name  String         @unique
  users UserInterest[]
}

model UserInterest {
  userId     Int
  interestId Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([userId, interestId])
  @@index([interestId])
}

model Community {
  id            Int                   @id @default(autoincrement())
  name          String
  goal          String
  description   String                @default("")
  intent        String
  timeline      String                @default("1 Week")
  ownerId       Int
  maxMembers    Int                   @default(6)
  stage         String                @default("Create")
  isPrivate     Boolean               @default(false)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  owner         User                  @relation("CommunityOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members       CommunityMember[]
  invitations   CommunityInvitation[]
  tasks         Task[]
  conversations Conversation[]

  @@index([ownerId])
  @@index([intent, stage])
}

model CommunityMember {
  communityId Int
  userId      Int
  role        String    @default("member")
  joinedAt    DateTime  @default(now())
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([communityId, userId])
  @@index([userId])
}

model CommunityInvitation {
  id          Int       @id @default(autoincrement())
  communityId Int
  inviterId   Int
  inviteeId   Int
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  inviter     User      @relation("InvitationSender", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee     User      @relation("InvitationReceiver", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@index([inviteeId, status])
  @@index([communityId, status])
}

model CollaborationRequest {
  id         Int      @id @default(autoincrement())
  senderId   Int
  receiverId Int
  status     String   @default("pending")
  message    String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  sender     User     @relation("RequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User     @relation("RequestReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId, status])
  @@index([receiverId, status])
}

model Project {
  id             Int                  @id @default(autoincrement())
  ownerId        Int
  title          String
  description    String
  category       String
  status         String               @default("Idea")
  visibility     String               @default("public")
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  owner          User                 @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  requiredSkills ProjectSkill[]
  members        ProjectMember[]
  joinRequests   ProjectJoinRequest[]
  tasks          Task[]

  @@index([category, status])
  @@index([ownerId])
}

model ProjectSkill {
  projectId Int
  skillId   Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill     Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([projectId, skillId])
  @@index([skillId])
}

model ProjectMember {
  projectId Int
  userId    Int
  role      String   @default("member")
  joinedAt  DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

model ProjectJoinRequest {
  id          Int      @id @default(autoincrement())
  projectId   Int
  applicantId Int
  reviewerId  Int?
  message     String   @default("")
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  applicant   User     @relation("ProjectApplicant", fields: [applicantId], references: [id], onDelete: Cascade)
  reviewer    User?    @relation("ProjectReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([applicantId, status])
}

model Task {
  id          Int            @id @default(autoincrement())
  title       String
  description String         @default("")
  status      String         @default("To Do")
  priority    String         @default("Medium")
  dueAt       DateTime?
  communityId Int?
  projectId   Int?
  createdById Int
  assigneeId  Int?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  community   Community?     @relation(fields: [communityId], references: [id], onDelete: Cascade)
  project     Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User           @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Cascade)
  assignee    User?          @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  activities  TaskActivity[]

  @@index([communityId, status])
  @@index([projectId, status])
  @@index([assigneeId, dueAt])
}

model TaskActivity {
  id        Int      @id @default(autoincrement())
  taskId    Int
  actorId   Int
  action    String
  details   String   @default("")
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model Conversation {
  id          Int                  @id @default(autoincrement())
  kind        String               @default("direct")
  communityId Int?
  createdAt   DateTime             @default(now())
  community   Community?           @relation(fields: [communityId], references: [id], onDelete: Cascade)
  members     ConversationMember[]
  messages    Message[]

  @@index([communityId])
}

model ConversationMember {
  conversationId Int
  userId         Int
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int
  senderId       Int
  body           String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String
  message   String
  href      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}
